# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ==============================================================================
FLASK_ENV=development
SECRET_KEY=lycaon_software_secret_key_change_me_in_production

# ==============================================================================
# CONEXIÓN A BASE DE DATOS (SOPORTE HÍBRIDO: XAMPP LOCAL & RENDER PRODUCCIÓN)
# ==============================================================================
# Modo 1 (Local - XAMPP por defecto):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lycaon_db

# Modo 2 (Producción - Render / Cloud):
# En Render puedes proveer directamente la URL de conexión completa:
# DATABASE_URL=mysql://usuario:password@dpg-xxxxx-a.oregon-postgres.render.com:3306/nombre_db
# MYSQL_URL=mysql://root:secret@roundhouse.proxy.rlwy.net:3306/railway

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP)
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
